# --- API Keys & Endpoints ---
MDR_API_KEY=your-api-key-here
MDR_BASE_URL=https://api.openai.com/v1
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# --- Models ---
MDR_TEXT_MODEL=gpt-4o-mini
MDR_VISION_MODEL=gpt-4o

# --- LLM Parameters ---
MDR_TEMPERATURE=0.7
MDR_RETRIES=3

# --- Research Hyperparameters ---
# N_R: number of research iterations
MDR_N_R=5
# N_K: number of search queries per iteration
MDR_N_K=10
# N_P: number of web pages per query (Firecrawl limit)
MDR_N_P=3
# N_L: number of learnings to extract per page
MDR_N_L=3

# --- Ablation ---
# none | section_generation | image_enrichment | adaptive_outline
MDR_ABLATION_MODE=none
# MDR_ADAPTIVE_OUTLINE=false
